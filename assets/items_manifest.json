{
 "item_version": "3",
 "items": [
  {
   "id": "P1-1",
   "sub": "P1",
   "type": "likert",
   "text": "途中で中断した作業のことが、別のことをしている間も繰り返し頭に浮かぶ。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "P1-2",
   "sub": "P1",
   "type": "likert",
   "text": "未完了の案件があると、休日でも気持ちが完全には切り替わらない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P1-3",
   "sub": "P1",
   "type": "likert",
   "text": "一度着手したことは、区切りがつくまで落ち着かない。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "P1-4",
   "sub": "P1",
   "type": "likert",
   "text": "やりかけの用件を思い出して、夜中や早朝に目が覚めることがある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P1-5",
   "sub": "P1",
   "type": "likert",
   "text": "締め切りまで日数があっても、着手した案件は常に意識の片隅にある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P1-6",
   "sub": "P1",
   "type": "likert",
   "text": "処理していない用件があっても、特に気にならない。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "P2-1",
   "sub": "P2",
   "type": "likert",
   "text": "目標を立てるとき、確実に届く水準よりやや上を設定する。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "P2-2",
   "sub": "P2",
   "type": "likert",
   "text": "「できて当たり前」の水準を、周囲より高く見積もっているほうだ。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P2-3",
   "sub": "P2",
   "type": "likert",
   "text": "平均的な出来では、自分としては不十分だと感じる。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "P2-4",
   "sub": "P2",
   "type": "likert",
   "text": "最初から確実に達成できる範囲に目標を抑えることが多い。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "P2-5",
   "sub": "P2",
   "type": "likert",
   "text": "一度達成した水準は、次はさらに上げないと満足できない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P2-6",
   "sub": "P2",
   "type": "likert",
   "text": "自分に課す基準は、周囲が求める基準より厳しい。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P3-1",
   "sub": "P3",
   "type": "likert",
   "text": "難しい課題ほど、やってみたいと感じる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "P3-2",
   "sub": "P3",
   "type": "likert",
   "text": "挑戦の場面では、まず「成功したときの成果」を思い描く。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P3-3",
   "sub": "P3",
   "type": "likert",
   "text": "失敗の可能性が頭をよぎると、着手をためらう。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "P3-4",
   "sub": "P3",
   "type": "likert",
   "text": "結果が読めない仕事より、確実に無難にこなせる仕事を選ぶ。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "P3-5",
   "sub": "P3",
   "type": "likert",
   "text": "評価される場面では、緊張よりも意欲が上回る。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P3-6",
   "sub": "P3",
   "type": "likert",
   "text": "恥をかくことを避けるために、目立つ役割を辞退することがある。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "P4-1",
   "sub": "P4",
   "type": "likert",
   "text": "うまくいったときは、次の目標を少し上げる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "P4-2",
   "sub": "P4",
   "type": "likert",
   "text": "失敗したときは、いったん水準を下げて足場を固め直す。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P4-3",
   "sub": "P4",
   "type": "likert",
   "text": "結果が悪くても、同じ高さの目標に固執してしまう。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "P4-4",
   "sub": "P4",
   "type": "likert",
   "text": "一度の失敗で、その目標自体をあきらめてしまう。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "P4-5",
   "sub": "P4",
   "type": "likert",
   "text": "実績と目標の差を、数値や具体的な事実で確認してから次を決める。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "P4-6",
   "sub": "P4",
   "type": "likert",
   "text": "成功しても目標は変えず、同じ水準を繰り返すことが多い。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "P5-1",
   "sub": "P5",
   "type": "likert",
   "text": "仕事、家庭、趣味など、場面ごとに気持ちを切り替えられる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "P5-2",
   "sub": "P5",
   "type": "likert",
   "text": "一つの領域の不調を、他の領域まで引きずることは少ない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P5-3",
   "sub": "P5",
   "type": "likert",
   "text": "役割が変わると、自分の振る舞いも自然に変わる。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "P5-4",
   "sub": "P5",
   "type": "likert",
   "text": "職場での出来事を、家に帰っても引きずってしまう。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "P5-5",
   "sub": "P5",
   "type": "likert",
   "text": "自分の中で「これはこれ、それはそれ」と線を引くのが得意だ。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "P5-6",
   "sub": "P5",
   "type": "likert",
   "text": "どの場面でも同じ調子で振る舞い、切り替えは苦手だ。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "E1-1",
   "sub": "E1",
   "type": "likert",
   "text": "新しいものや面白そうなものに、自然と引き寄せられる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "E1-2",
   "sub": "E1",
   "type": "likert",
   "text": "目に入ったものに興味を惹かれ、予定外の行動を取ることがある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E1-3",
   "sub": "E1",
   "type": "likert",
   "text": "魅力的な選択肢が現れると、すぐに気持ちが動く。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E1-4",
   "sub": "E1",
   "type": "likert",
   "text": "周囲に何があっても、自分の予定どおりに動く。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "E1-5",
   "sub": "E1",
   "type": "likert",
   "text": "環境が整っていると、自分でも驚くほど意欲が湧く。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E1-6",
   "sub": "E1",
   "type": "likert",
   "text": "「やりたくなる仕掛け」があると、行動量が明らかに増える。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "E2-1",
   "sub": "E2",
   "type": "likert",
   "text": "気の進まない要素が一つあると、その場全体が嫌になる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "E2-2",
   "sub": "E2",
   "type": "likert",
   "text": "苦手な相手が一人いるだけで、その場を避けたくなる。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E2-3",
   "sub": "E2",
   "type": "likert",
   "text": "少しでも嫌な予感がすると、早めに手を引く。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "E2-4",
   "sub": "E2",
   "type": "likert",
   "text": "多少不快な条件でも、目的のためなら気にならない。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "E2-5",
   "sub": "E2",
   "type": "likert",
   "text": "うまくいかなさそうな空気を、周囲より早く察知する。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E2-6",
   "sub": "E2",
   "type": "likert",
   "text": "苦手な作業は、着手までの時間が極端に長くなる。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E3-1",
   "sub": "E3",
   "type": "likert",
   "text": "正面から進めないとき、別のルートを探すのが得意だ。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "E3-2",
   "sub": "E3",
   "type": "likert",
   "text": "制約条件が多いほど、かえって工夫の余地を見つけられる。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E3-3",
   "sub": "E3",
   "type": "likert",
   "text": "壁にぶつかると、そこで止まってしまうことが多い。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "E3-4",
   "sub": "E3",
   "type": "likert",
   "text": "「できない理由」より先に「できる方法」を挙げる。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "E3-5",
   "sub": "E3",
   "type": "likert",
   "text": "障害の大きさを、実際よりも大きく感じてしまう。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "E3-6",
   "sub": "E3",
   "type": "likert",
   "text": "迂回して目的を達したことが、これまで何度もある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E4-1",
   "sub": "E4",
   "type": "likert",
   "text": "手順やルールが明文化されていないと落ち着かない。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "E4-2",
   "sub": "E4",
   "type": "likert",
   "text": "役割分担が曖昧な状況は苦手だ。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "E4-3",
   "sub": "E4",
   "type": "likert",
   "text": "何をしてもよい自由な状況のほうが、力を発揮できる。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "E4-4",
   "sub": "E4",
   "type": "likert",
   "text": "目的や評価基準が示されないと、動き出しにくい。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "E4-5",
   "sub": "E4",
   "type": "likert",
   "text": "前例のない案件でも、自分なりの型を作って進められる。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "E4-6",
   "sub": "E4",
   "type": "likert",
   "text": "指示が抽象的なときは、確認せずには進められない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "C1-1",
   "sub": "C1",
   "type": "likert",
   "text": "どちらも魅力的な選択肢があるとき、比較的すぐに決められる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "C1-2",
   "sub": "C1",
   "type": "likert",
   "text": "良い候補が複数あると、決めきれずに時間だけが過ぎる。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "C1-3",
   "sub": "C1",
   "type": "likert",
   "text": "選んだ後に「もう一方も良かった」と引き返したくなる。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "C1-4",
   "sub": "C1",
   "type": "likert",
   "text": "甲乙つけがたい場面では、基準を先に決めて機械的に選ぶ。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "C1-5",
   "sub": "C1",
   "type": "likert",
   "text": "決定の直前で、二つの間を何度も気持ちが行き来する。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "C2-1",
   "sub": "C2",
   "type": "likert",
   "text": "どちらも避けたい選択肢しかないとき、決断を先送りしてしまう。",
   "rev": true,
   "short": true,
   "screen": true
  },
  {
   "id": "C2-2",
   "sub": "C2",
   "type": "likert",
   "text": "二択がどちらも不利なとき、第三の道を探す。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "C2-3",
   "sub": "C2",
   "type": "likert",
   "text": "嫌な選択を迫られると、その場から離れたくなる。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "C2-4",
   "sub": "C2",
   "type": "likert",
   "text": "損失が避けられない場面でも、被害の小さいほうを選べる。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "C2-5",
   "sub": "C2",
   "type": "likert",
   "text": "板挟みになると、何も決めないまま状況に流されることがある。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "C3-1",
   "sub": "C3",
   "type": "likert",
   "text": "魅力と不安が同居する話でも、決めた後は迷いを断てる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "C3-2",
   "sub": "C3",
   "type": "likert",
   "text": "目標に近づくほど不安が強まり、直前でためらう。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "C3-3",
   "sub": "C3",
   "type": "likert",
   "text": "やりたい気持ちと避けたい気持ちの間で、行き来が長く続く。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "C3-4",
   "sub": "C3",
   "type": "likert",
   "text": "利得とリスクを書き出し、条件をつけたうえで進める。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "C3-5",
   "sub": "C3",
   "type": "likert",
   "text": "期待が大きい案件ほど、着手が遅れる。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "C4-1",
   "sub": "C4",
   "type": "likert",
   "text": "複数の要素が絡む選択でも、優先順位をつけて整理できる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "C4-2",
   "sub": "C4",
   "type": "likert",
   "text": "利害が複雑に絡むと、判断そのものを避けたくなる。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "C4-3",
   "sub": "C4",
   "type": "likert",
   "text": "関係者の思惑が異なる場面でも、落としどころを見つけられる。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "C4-4",
   "sub": "C4",
   "type": "likert",
   "text": "条件が多いほど混乱し、結論が出せなくなる。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "C4-5",
   "sub": "C4",
   "type": "likert",
   "text": "複雑な状況は、図や表に整理してから考える習慣がある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F1-1",
   "sub": "F1",
   "type": "likert",
   "text": "現状に問題があれば、自分から動き出す。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "F1-2",
   "sub": "F1",
   "type": "likert",
   "text": "誰かが言い出すのを待つより、自分が最初の一人になる。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F1-3",
   "sub": "F1",
   "type": "likert",
   "text": "変えるべきだと思っても、実際に動くのは他人任せになりがちだ。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "F1-4",
   "sub": "F1",
   "type": "likert",
   "text": "周囲を巻き込むための働きかけを、具体的に行う。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F1-5",
   "sub": "F1",
   "type": "likert",
   "text": "改善案は、口頭だけでなく文書や数字の形にして示す。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "F1-6",
   "sub": "F1",
   "type": "likert",
   "text": "変化を起こす提案をしたことは、ここ一年ほとんどない。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "F2-1",
   "sub": "F2",
   "type": "likert",
   "text": "反対しそうな人が誰か、事前に見当がつく。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "F2-2",
   "sub": "F2",
   "type": "likert",
   "text": "抵抗の理由を、感情ではなく利害や不安として捉える。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F2-3",
   "sub": "F2",
   "type": "likert",
   "text": "反対されると、説得するより押し通そうとする。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "F2-4",
   "sub": "F2",
   "type": "likert",
   "text": "変化で不利益を被る人に、あらかじめ手当てを考える。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "F2-5",
   "sub": "F2",
   "type": "likert",
   "text": "表立った反対より、沈黙や様子見のほうが重要な信号だと感じる。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F2-6",
   "sub": "F2",
   "type": "likert",
   "text": "抵抗が表面化してから、初めてその存在に気づくことが多い。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "F3-1",
   "sub": "F3",
   "type": "likert",
   "text": "長年の慣行でも、根拠が薄ければ見直しを提起できる。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "F3-2",
   "sub": "F3",
   "type": "likert",
   "text": "「今までこうだった」という理由には納得しない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F3-3",
   "sub": "F3",
   "type": "likert",
   "text": "既存のやり方を崩すことに、強い抵抗感がある。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "F3-4",
   "sub": "F3",
   "type": "likert",
   "text": "問題を可視化して、危機感を共有する働きかけができる。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F3-5",
   "sub": "F3",
   "type": "likert",
   "text": "自分自身の習慣を変えるのは苦手だ。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "F3-6",
   "sub": "F3",
   "type": "likert",
   "text": "現状維持のコストを具体的に示して、議論を始められる。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "F4-1",
   "sub": "F4",
   "type": "likert",
   "text": "変更した内容は、手順書や記録の形に落とし込む。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "F4-2",
   "sub": "F4",
   "type": "likert",
   "text": "一度決めたことが元に戻らないよう、仕組みで支える。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F4-3",
   "sub": "F4",
   "type": "likert",
   "text": "変えた直後は良くても、しばらくすると元に戻ってしまう。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "F4-4",
   "sub": "F4",
   "type": "likert",
   "text": "定着したかどうかを、一定期間おいてから確認する。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "F4-5",
   "sub": "F4",
   "type": "likert",
   "text": "新しいやり方を、教育や訓練の形にまで展開する。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "F4-6",
   "sub": "F4",
   "type": "likert",
   "text": "提案はするが、その後のフォローは続かない。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "G1-1",
   "sub": "G1",
   "type": "likert",
   "text": "全員が同じ意見でも、違うと思えば口に出す。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "G1-2",
   "sub": "G1",
   "type": "likert",
   "text": "場の空気に合わせて、発言を変えることが多い。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "G1-3",
   "sub": "G1",
   "type": "likert",
   "text": "少数意見の側に立つことを恐れない。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "G1-4",
   "sub": "G1",
   "type": "likert",
   "text": "多数派の判断は、多くの場合正しいと考える。",
   "rev": true,
   "short": false,
   "screen": false
  },
  {
   "id": "G1-5",
   "sub": "G1",
   "type": "likert",
   "text": "自分の判断基準を、集団の基準より優先することがある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "G2-1",
   "sub": "G2",
   "type": "likert",
   "text": "重要な変更は、関係者が話し合って決めたほうが定着すると考える。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "G2-2",
   "sub": "G2",
   "type": "likert",
   "text": "説得するより、当事者自身に決めてもらうほうが有効だと思う。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "G2-3",
   "sub": "G2",
   "type": "likert",
   "text": "決定は責任者が単独で下すほうが効率的だ。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "G2-4",
   "sub": "G2",
   "type": "likert",
   "text": "会議では、結論そのものと同じくらい合意の過程を重視する。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "G2-5",
   "sub": "G2",
   "type": "likert",
   "text": "全員に発言の機会が回るよう意識している。",
   "rev": false,
   "short": true,
   "screen": false
  },
