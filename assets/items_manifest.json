   "short": false,
   "screen": false
  },
  {
   "id": "G4-1",
   "sub": "G4",
   "type": "likert",
   "text": "複数の立場の間に立つ役回りになることが多い。",
   "rev": false,
   "short": true,
   "screen": true
  },
  {
   "id": "G4-2",
   "sub": "G4",
   "type": "likert",
   "text": "どの集団にも完全には属していない感覚がある。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "G4-3",
   "sub": "G4",
   "type": "likert",
   "text": "一つの集団に深く帰属することで安心を得る。",
   "rev": true,
   "short": true,
   "screen": false
  },
  {
   "id": "G4-4",
   "sub": "G4",
   "type": "likert",
   "text": "立場の異なる集団の言葉を、互いに翻訳して伝えることがある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "G4-5",
   "sub": "G4",
   "type": "likert",
   "text": "どちらの側からも「あちら側の人」と見られていると感じることがある。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "G4-6",
   "sub": "G4",
   "type": "likert",
   "text": "自分を説明するとき、所属よりも役割で語ることが多い。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V1-1",
   "sub": "V1",
   "type": "likert",
   "text": "これまで一度も、約束の時間に遅れたことがない。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "V1-2",
   "sub": "V1",
   "type": "likert",
   "text": "誰に対しても、いらだちを感じたことは一度もない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V1-3",
   "sub": "V1",
   "type": "likert",
   "text": "自分の非を認めなかったことは、一度もない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V1-4",
   "sub": "V1",
   "type": "likert",
   "text": "他人の成功をうらやましく思ったことは、一度もない。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "V1-5",
   "sub": "V1",
   "type": "likert",
   "text": "面倒だと感じて手を抜いたことは、一度もない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V1-6",
   "sub": "V1",
   "type": "likert",
   "text": "陰で人の批判をしたことは、一度もない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V2-1",
   "sub": "V2",
   "type": "likert",
   "text": "終わっていない仕事は、片づくまで気になり続ける。",
   "rev": false,
   "short": true,
   "screen": false
  },
  {
   "id": "V2-2",
   "sub": "V2",
   "type": "likert",
   "text": "目標は少し高めに置くほうだ。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V2-3",
   "sub": "V2",
   "type": "likert",
   "text": "難題であるほど意欲が湧く。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V2-4",
   "sub": "V2",
   "type": "likert",
   "text": "手順やルールがはっきりしていないと落ち着かない。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V2-5",
   "sub": "V2",
   "type": "likert",
   "text": "変えると決めたことは、仕組みにして残す。",
   "rev": false,
   "short": false,
   "screen": false
  },
  {
   "id": "V2-6",
   "sub": "V2",
   "type": "likert",
   "text": "場の空気に合わせて、自分の発言を変えることが多い。",
   "rev": false,
   "short": false,
   "screen": false
  }
 ]
